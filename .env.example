# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Public URL of the app (no trailing slash) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sign-in restrictions ---
# Optional: comma-separated email domains allowed to register (empty = any).
ALLOWED_EMAIL_DOMAINS=

# --- Device verification cookie ---
# 32+ random bytes. Generate with: openssl rand -base64 48
DEVICE_COOKIE_SECRET=change-me

# --- Email (verification codes, invites, alerts) via Resend ---
RESEND_API_KEY=re_xxx
EMAIL_FROM="HOMEi <no-reply@yourdomain.com>"

# --- Document scanning via Claude API ---
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Vercel Cron protection ---
CRON_SECRET=change-me
